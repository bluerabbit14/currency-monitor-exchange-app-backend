# Loaded by the dev and test profiles. Do not put the user or password in DB_URL.
# Production reads these same variables from the process environment instead of this file.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Resend. RESEND_FROM must be a verified sender. Do not wrap the value in quotes.
# Example: Currency <otp@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM=

# Redis (OTP challenges). The user needs write access (not a read-only token).
# Example: redis://localhost:6379 or rediss://default:password@host:6379
REDIS_URL=

# Secrets required at startup (see application.properties).
OTP_PEPPER=
JWT_SECRET=

# Rate collection. Leave RATES_COLLECTION_ENABLED unset/false to never call a provider.
RATES_COLLECTION_ENABLED=
TWELVEDATA_API_KEY=

# CoinGecko crypto collection (every 5 min). Needs both values to run; leave COINGECKO_COLLECTION_ENABLED unset/false to never call it.
COINGECKO_COLLECTION_ENABLED=
COINGECKO_API_KEY=

# Gold API commodity collection (every 10 min, max 10 requests per hour). Leave unset/false to never call it.
GOLDAPI_COLLECTION_ENABLED=
GOLDAPI_API_KEY=

# Google sign-in (OIDC): the Web OAuth client ID ID tokens must be issued for. Leave empty to keep Google sign-in off.
# Admin endpoints (X-Admin-Key header). Leave empty to keep them closed.
ADMIN_API_KEY=

GOOGLE_WEB_CLIENT_ID=

# Firebase Admin SDK (FCM push). Copy these from the service-account JSON. Leave FIREBASE_PROJECT_ID empty to keep push off.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_ID=
# Keep the private key on ONE line: line breaks written as backslash-n, whole value in double quotes
FIREBASE_PRIVATE_KEY=
