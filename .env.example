# Loaded by the dev and test profiles. Do not put the user or password in DB_URL.
# Production reads these same variables from the process environment instead of this file.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Resend. RESEND_FROM must be a verified sender. Do not wrap the value in quotes.
# Example: Currency <otp@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM=

# Redis (OTP challenges). The user needs write access (not a read-only token).
# Example: redis://localhost:6379 or rediss://default:password@host:6379
REDIS_URL=

# Secrets required at startup (see application.properties).
OTP_PEPPER=
JWT_SECRET=
